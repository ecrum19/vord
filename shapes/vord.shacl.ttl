@prefix vord: <https://w3id.org/vord#> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vord:ServiceWithLimitsShape a sh:NodeShape ;
  sh:targetClass sd:Service ;
  sh:property [
    sh:path vord:hasLimit ;
    sh:minCount 1 ;
    sh:class vord:Limit ;
  ] .

vord:LimitShape a sh:NodeShape ;
  sh:targetClass vord:Limit ;
  sh:property [
    sh:path vord:metric ;
    sh:maxCount 1 ;
    sh:class vord:Metric ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:minValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:hardLimit ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path vord:hasScope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vord:Scope ;
  ] ;
  sh:property [
    sh:path vord:enforcement ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vord:EnforcementMode ;
  ] ;
  sh:property [
    sh:path vord:unit ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path vord:windowDuration ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path vord:retryAfterHint ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path vord:returnsStatusCode ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:httpSignalHeader ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] .

vord:RateLimitShape a sh:NodeShape ;
  sh:targetClass vord:RateLimit ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:requestsPerWindow vord:requestsPerDay ) ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:windowDuration ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path vord:burstValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vord:ResultSizeLimitShape a sh:NodeShape ;
  sh:targetClass vord:ResultSizeLimit ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:resultBindings ) ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vord:CostModelLimitShape a sh:NodeShape ;
  sh:targetClass vord:CostModelLimit ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:estimatedCostUnits ) ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:costModel ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vord:CostModel ;
  ] .

vord:ServerLoadLimitShape a sh:NodeShape ;
  sh:targetClass vord:ServerLoadLimit ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vord:ConcurrentRequestsLimitShape a sh:NodeShape ;
  sh:targetClass vord:ConcurrentRequestsLimit ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vord:ResponseTimeLimitShape a sh:NodeShape ;
  sh:targetClass vord:ResponseTimeLimit ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vord:QuotaLimitShape a sh:NodeShape ;
  sh:targetClass vord:QuotaLimit ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:requestsPerDay ) ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vord:FederationSupportedShape a sh:NodeShape ;
  sh:targetClass vord:FederationSupported ;
  sh:property [
    sh:path vord:federationSupported ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
  ] .
