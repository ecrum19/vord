@prefix vord: <https://w3id.org/vord#> .
@prefix vords: <https://w3id.org/vord/shapes#> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vords:ServiceWithRestrictionsShape a sh:NodeShape ;
  sh:targetClass sd:Service ;
  sh:property [
    sh:path vord:hasRestriction ;
    sh:minCount 1 ;
    sh:class vord:Restriction ;
  ] .

vords:RestrictionShape a sh:NodeShape ;
  sh:targetClass vord:Restriction ;
  sh:property [
    sh:path vord:metric ;
    sh:maxCount 1 ;
    sh:class vord:Metric ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:minValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:hardRestriction ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path vord:hasScope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vord:Scope ;
  ] ;
  sh:property [
    sh:path vord:enforcement ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vord:EnforcementMode ;
  ] ;
  sh:property [
    sh:path vord:unit ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path vord:windowDuration ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path vord:retryAfterHint ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path vord:returnsStatusCode ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:httpSignalHeader ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path vord:burstValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:penaltyThreshold ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
  ] ;
  sh:property [
    sh:path vord:penaltyDuration ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path vord:penalized ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
  ] .

vords:PenaltyShape a sh:NodeShape ;
  sh:targetSubjectsOf vord:penaltyThreshold ;
  sh:property [
    sh:path vord:penaltyDuration ;
    sh:minCount 1 ;
    sh:message "A restriction with vord:penaltyThreshold must state vord:penaltyDuration." ;
  ] ;
  sh:property [
    sh:path vord:penalized ;
    sh:in ( true ) ;
    sh:message "A restriction with vord:penaltyThreshold is penalized: vord:penalized cannot be false." ;
  ] .

vords:RateRestrictionShape a sh:NodeShape ;
  sh:targetClass vord:RateRestriction ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:requestsPerWindow vord:requestsPerDay vord:failedRequestsPerWindow ) ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:windowDuration ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path vord:burstValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vords:ResultSizeRestrictionShape a sh:NodeShape ;
  sh:targetClass vord:ResultSizeRestriction ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:resultBindings ) ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vords:CostModelRestrictionShape a sh:NodeShape ;
  sh:targetClass vord:CostModelRestriction ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:estimatedCostUnits vord:costUnitsPerWindow ) ;
  ] ;
  # A usage budget (vord:costUnitsPerWindow) needs the window in which its units are counted.
  sh:or (
    [ sh:property [ sh:path vord:metric ; sh:hasValue vord:estimatedCostUnits ] ]
    [ sh:property [ sh:path vord:windowDuration ; sh:minCount 1 ] ]
  ) ;
  sh:message "A cost-model restriction with metric vord:costUnitsPerWindow must state vord:windowDuration." ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path vord:costModel ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vord:CostModel ;
  ] .

vords:ServerLoadRestrictionShape a sh:NodeShape ;
  sh:targetClass vord:ServerLoadRestriction ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vords:ConcurrentRequestsRestrictionShape a sh:NodeShape ;
  sh:targetClass vord:ConcurrentRequestsRestriction ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vords:ResponseTimeRestrictionShape a sh:NodeShape ;
  sh:targetClass vord:ResponseTimeRestriction ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:evaluationTime ) ;
  ] ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vords:QuotaRestrictionShape a sh:NodeShape ;
  sh:targetClass vord:QuotaRestriction ;
  sh:property [
    sh:path vord:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( vord:requestsPerDay vord:evaluationTimePerWindow ) ;
  ] ;
  # A processing-time budget (vord:evaluationTimePerWindow) needs the window in which its time is summed.
  sh:or (
    [ sh:property [ sh:path vord:metric ; sh:hasValue vord:requestsPerDay ] ]
    [ sh:property [ sh:path vord:windowDuration ; sh:minCount 1 ] ]
  ) ;
  sh:message "A quota restriction with metric vord:evaluationTimePerWindow must state vord:windowDuration." ;
  sh:property [
    sh:path vord:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

vords:IdentificationRestrictionShape a sh:NodeShape ;
  sh:targetClass vord:IdentificationRestriction ;
  sh:property [
    sh:path vord:identificationHeader ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
  ] ;
  sh:property [
    sh:path vord:identificationFormat ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class vord:IdentificationFormat ;
  ] .
