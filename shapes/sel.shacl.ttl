@prefix sel: <https://w3id.org/sparql-endpoint-limits#> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sel:ServiceWithLimitsShape a sh:NodeShape ;
  sh:targetClass sd:Service ;
  sh:or (
    [ sh:property [ sh:path sel:hasLimit ; sh:minCount 1 ] ]
    [ sh:property [ sh:path sel:hasLimitProfile ; sh:minCount 1 ] ]
  ) ;
  sh:property [
    sh:path sel:hasLimit ;
    sh:class sel:Limit ;
  ] ;
  sh:property [
    sh:path sel:hasLimitProfile ;
    sh:class sel:LimitProfile ;
  ] .

sel:LimitProfileShape a sh:NodeShape ;
  sh:targetClass sel:LimitProfile ;
  sh:property [
    sh:path sel:profileLimit ;
    sh:minCount 1 ;
    sh:class sel:Limit ;
  ] .

sel:LimitShape a sh:NodeShape ;
  sh:targetClass sel:Limit ;
  sh:property [
    sh:path sel:metric ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class sel:Metric ;
  ] ;
  sh:property [
    sh:path sel:maxValue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path sel:hardLimit ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path sel:hasScope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class sel:Scope ;
  ] ;
  sh:property [
    sh:path sel:enforcement ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class sel:EnforcementMode ;
  ] ;
  sh:property [
    sh:path sel:unit ;
    sh:maxCount 1 ;
    sh:datatype xsd:token ;
  ] ;
  sh:property [
    sh:path sel:windowDuration ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path sel:retryAfterHint ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path sel:returnsStatusCode ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
  ] .

sel:RateLimitShape a sh:NodeShape ;
  sh:targetClass sel:RateLimit ;
  sh:property [
    sh:path sel:windowDuration ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:duration ;
  ] ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:requestsPerWindow sel:requestsPerDay ) ;
  ] ;
  sh:property [
    sh:path sel:burstValue ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] .

sel:ResultSizeLimitShape a sh:NodeShape ;
  sh:targetClass sel:ResultSizeLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:resultRows sel:resultBytes ) ;
  ] .

sel:QuerySizeLimitShape a sh:NodeShape ;
  sh:targetClass sel:QuerySizeLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:queryBytes sel:valuesItems sel:literalBytes ) ;
  ] .

sel:CostModelLimitShape a sh:NodeShape ;
  sh:targetClass sel:CostModelLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:estimatedCostUnits ) ;
  ] ;
  sh:property [
    sh:path sel:costModel ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class sel:CostModel ;
  ] .

sel:ServerLoadLimitShape a sh:NodeShape ;
  sh:targetClass sel:ServerLoadLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:cpuLoadRatio sel:activeQueryCount ) ;
  ] .

sel:ConnectionLimitShape a sh:NodeShape ;
  sh:targetClass sel:ConnectionLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:concurrentConnections sel:concurrentQueries ) ;
  ] .

sel:TimeoutLimitShape a sh:NodeShape ;
  sh:targetClass sel:TimeoutLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:executionSeconds sel:queueWaitSeconds ) ;
  ] .

sel:QueueLimitShape a sh:NodeShape ;
  sh:targetClass sel:QueueLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:queueDepth sel:queueWaitSeconds ) ;
  ] .

sel:QuotaLimitShape a sh:NodeShape ;
  sh:targetClass sel:QuotaLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:requestsPerDay ) ;
  ] .

sel:FederatedQueryLimitShape a sh:NodeShape ;
  sh:targetClass sel:FederatedQueryLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:subqueryDepth sel:federatedServiceCount ) ;
  ] .

sel:UpdateLimitShape a sh:NodeShape ;
  sh:targetClass sel:UpdateLimit ;
  sh:property [
    sh:path sel:metric ;
    sh:in ( sel:updateBytes ) ;
  ] .
