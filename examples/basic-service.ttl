@prefix ex: <https://example.org/sparql/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix vord: <https://w3id.org/vord#> .

ex:service a sd:Service ;
  sd:endpoint <https://example.org/sparql> ;
  sd:supportedLanguage sd:SPARQLQuery, sd:SPARQLUpdate ;
  sd:feature sd:BasicFederatedQuery ;
  vord:hasLimit
    ex:rateLimit,
    ex:resultLimit,
    ex:querySizeLimit,
    ex:costLimit,
    ex:serverLoadLimit,
    ex:connectionLimit,
    ex:timeoutLimit,
    ex:queueLimit,
    ex:federationLimit,
    ex:updateLimit .

ex:internalCostModelV3 a vord:CostModel ;
  rdfs:label "Internal Cost Model v3"@en .

ex:rateLimit a vord:Limit, vord:RateLimit ;
  vord:metric vord:requestsPerWindow ;
  vord:maxValue "60"^^xsd:decimal ;
  vord:burstValue "15"^^xsd:decimal ;
  vord:unit "requests"^^xsd:token ;
  vord:windowDuration "PT1M"^^xsd:duration ;
  vord:hasScope vord:PerClientIP ;
  vord:enforcement vord:RejectRequest ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:returnsStatusCode "429"^^xsd:integer ;
  vord:signalsHeader <http://www.w3.org/2011/http-headers#retry-after> ;
  vord:retryAfterHint "PT30S"^^xsd:duration ;
  vord:appliesToOperation vord:ProtocolOperation .

ex:resultLimit a vord:Limit, vord:ResultSizeLimit ;
  vord:metric vord:resultBytes ;
  vord:maxValue "10000000"^^xsd:decimal ;
  vord:unit "bytes"^^xsd:token ;
  vord:hasScope vord:PerRequest ;
  vord:enforcement vord:TruncateResult ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:appliesToOperation vord:QueryOperation .

ex:querySizeLimit a vord:Limit, vord:QuerySizeLimit ;
  vord:metric vord:queryBytes ;
  vord:maxValue "131072"^^xsd:decimal ;
  vord:unit "bytes"^^xsd:token ;
  vord:hasScope vord:PerRequest ;
  vord:enforcement vord:RejectRequest ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:appliesToOperation vord:QueryOperation .

ex:costLimit a vord:Limit, vord:CostModelLimit ;
  vord:metric vord:estimatedCostUnits ;
  vord:maxValue "150000"^^xsd:decimal ;
  vord:unit "cost-units"^^xsd:token ;
  vord:costModel ex:internalCostModelV3 ;
  vord:hasScope vord:PerRequest ;
  vord:enforcement vord:RejectRequest ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:appliesToOperation vord:QueryOperation .

ex:serverLoadLimit a vord:Limit, vord:ServerLoadLimit ;
  vord:metric vord:cpuLoadRatio ;
  vord:maxValue "0.85"^^xsd:decimal ;
  vord:unit "ratio"^^xsd:token ;
  vord:hasScope vord:GlobalScope ;
  vord:enforcement vord:DegradeQuality ;
  vord:hardLimit "false"^^xsd:boolean ;
  vord:appliesToOperation vord:QueryOperation .

ex:connectionLimit a vord:Limit, vord:ConnectionLimit ;
  vord:metric vord:concurrentConnections ;
  vord:maxValue "200"^^xsd:decimal ;
  vord:unit "connections"^^xsd:token ;
  vord:hasScope vord:GlobalScope ;
  vord:enforcement vord:RejectRequest ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:returnsStatusCode "503"^^xsd:integer ;
  vord:appliesToOperation vord:ProtocolOperation .

ex:timeoutLimit a vord:Limit, vord:TimeoutLimit ;
  vord:metric vord:executionSeconds ;
  vord:maxValue "30"^^xsd:decimal ;
  vord:unit "seconds"^^xsd:token ;
  vord:hasScope vord:PerRequest ;
  vord:enforcement vord:RejectRequest ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:returnsStatusCode "503"^^xsd:integer ;
  vord:appliesToOperation vord:QueryOperation .

ex:queueLimit a vord:Limit, vord:QueueLimit ;
  vord:metric vord:queueDepth ;
  vord:maxValue "100"^^xsd:decimal ;
  vord:unit "queries"^^xsd:token ;
  vord:hasScope vord:GlobalScope ;
  vord:enforcement vord:QueueRequest ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:appliesToOperation vord:QueryOperation .

ex:federationLimit a vord:Limit, vord:FederatedQueryLimit ;
  vord:metric vord:federatedServiceCount ;
  vord:maxValue "5"^^xsd:decimal ;
  vord:unit "services"^^xsd:token ;
  vord:hasScope vord:PerRequest ;
  vord:enforcement vord:RejectRequest ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:appliesToOperation vord:FederationOperation .

ex:updateLimit a vord:Limit, vord:UpdateLimit ;
  vord:metric vord:updateBytes ;
  vord:maxValue "1048576"^^xsd:decimal ;
  vord:unit "bytes"^^xsd:token ;
  vord:hasScope vord:PerRequest ;
  vord:enforcement vord:RejectRequest ;
  vord:hardLimit "true"^^xsd:boolean ;
  vord:appliesToOperation vord:UpdateOperation .
